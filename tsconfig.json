{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@screens/*": ["./src/screens/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@config/*": ["./config/*"]
    },
    "skipLibCheck": true,
    "types": ["node", "mocha", "chai", "@wdio/globals/types"]
  },
  "include": ["src/**/*.ts", "config/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
